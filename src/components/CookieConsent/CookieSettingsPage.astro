---
---

<section class='cookie-settings' id='cookie-settings'>
 <div class='panel'>
  <header class='header'>
   <h2>Preferencias</h2>
   <p>
    Elige qué cookies quieres permitir. Puedes cambiar esta configuración en
    cualquier momento.
   </p>
  </header>

  <div class='success' id='cookie-settings-success' hidden>
   Configuración guardada correctamente
  </div>

  <div class='categories'>
   <div class='category'>
    <div class='category-header'>
     <label class='category-label'>
      <input type='checkbox' checked disabled />
      <span>Cookies necesarias</span>
     </label>
     <span class='status'>Siempre activas</span>
    </div>
    <p class='category-desc'>
     Esenciales para el funcionamiento del sitio. Incluyen navegación básica y
     no se pueden desactivar.
    </p>
   </div>

   <div class='category'>
    <div class='category-header'>
     <label class='category-label'>
      <input type='checkbox' id='cookie-analytics' />
      <span>Cookies de análisis</span>
     </label>
     <span class='status' data-status-for='cookie-analytics'>Desactivadas</span>
    </div>
    <p class='category-desc'>
     Nos ayudan a entender cómo se usa el sitio de forma anónima para mejorar la
     experiencia.
    </p>
   </div>

   <div class='category'>
    <div class='category-header'>
     <label class='category-label'>
      <input type='checkbox' id='cookie-marketing' />
      <span>Cookies de marketing</span>
     </label>
     <span class='status' data-status-for='cookie-marketing'>Desactivadas</span>
    </div>
    <p class='category-desc'>
     Se usan para mostrar contenido y anuncios más relevantes según tu
     navegación.
    </p>
   </div>

   <div class='category'>
    <div class='category-header'>
     <label class='category-label'>
      <input type='checkbox' id='cookie-preferences' />
      <span>Cookies de preferencias</span>
     </label>
     <span class='status' data-status-for='cookie-preferences'>Desactivadas</span>
    </div>
    <p class='category-desc'>
     Recuerdan opciones como idioma o región para personalizar la web.
    </p>
   </div>
  </div>

  <div class='actions'>
   <button type='button' class='btn btn-reset' id='cookie-settings-reset'>
    Restablecer
   </button>
   <button type='button' class='btn btn-save' id='cookie-settings-save'>
    Guardar configuración
   </button>
  </div>

  <p class='legal'>
   Más info en nuestra
   <a href='/politica-cookies'>Política de Cookies</a>.
  </p>
 </div>
</section>

<script>
 const STORAGE_PREFERENCES = "cookie-preferences"
 const STORAGE_CONSENT = "cookie-consent"

 function readPreferences() {
  try {
   const raw =
    localStorage.getItem(STORAGE_PREFERENCES) ||
    localStorage.getItem(STORAGE_CONSENT)
   if (!raw) {
    return {
     necessary: true,
     analytics: false,
     marketing: false,
     preferences: false,
    }
   }
   const parsed = JSON.parse(raw)
   return {
    necessary: true,
    analytics: !!parsed.analytics,
    marketing: !!parsed.marketing,
    preferences: !!parsed.preferences,
   }
  } catch {
   return {
    necessary: true,
    analytics: false,
    marketing: false,
    preferences: false,
   }
  }
 }

 function savePreferences(preferences) {
  const payload = JSON.stringify(preferences)
  localStorage.setItem(STORAGE_PREFERENCES, payload)
  localStorage.setItem(STORAGE_CONSENT, payload)
 }

 function updateStatusLabels() {
  document.querySelectorAll("[data-status-for]").forEach((el) => {
   const id = el.getAttribute("data-status-for")
   const input = id ? document.getElementById(id) : null
   if (!(input instanceof HTMLInputElement)) return
   el.textContent = input.checked ? "Activadas" : "Desactivadas"
  })
 }

 function applyToForm(preferences) {
  const analytics = document.getElementById("cookie-analytics")
  const marketing = document.getElementById("cookie-marketing")
  const prefs = document.getElementById("cookie-preferences")

  if (analytics instanceof HTMLInputElement) analytics.checked = preferences.analytics
  if (marketing instanceof HTMLInputElement) marketing.checked = preferences.marketing
  if (prefs instanceof HTMLInputElement) prefs.checked = preferences.preferences

  updateStatusLabels()
 }

 function getFromForm() {
  const analytics = document.getElementById("cookie-analytics")
  const marketing = document.getElementById("cookie-marketing")
  const prefs = document.getElementById("cookie-preferences")

  return {
   necessary: true,
   analytics: analytics instanceof HTMLInputElement ? analytics.checked : false,
   marketing: marketing instanceof HTMLInputElement ? marketing.checked : false,
   preferences: prefs instanceof HTMLInputElement ? prefs.checked : false,
  }
 }

 function showSuccess() {
  const el = document.getElementById("cookie-settings-success")
  if (!el) return
  el.hidden = false
  window.setTimeout(() => {
   el.hidden = true
  }, 2000)
 }

 function initCookieSettings() {
  const root = document.getElementById("cookie-settings")
  if (!root) return

  applyToForm(readPreferences())

  if (root.dataset.bound === "true") return
  root.dataset.bound = "true"

  ;["cookie-analytics", "cookie-marketing", "cookie-preferences"].forEach(
   (id) => {
    document.getElementById(id)?.addEventListener("change", updateStatusLabels)
   },
  )

  document
   .getElementById("cookie-settings-save")
   ?.addEventListener("click", () => {
    const preferences = getFromForm()
    savePreferences(preferences)
    showSuccess()
    window.setTimeout(() => {
     window.location.href = "/"
    }, 1200)
   })

  document
   .getElementById("cookie-settings-reset")
   ?.addEventListener("click", () => {
    const defaults = {
     necessary: true,
     analytics: false,
     marketing: false,
     preferences: false,
    }
    localStorage.removeItem(STORAGE_PREFERENCES)
    localStorage.removeItem(STORAGE_CONSENT)
    applyToForm(defaults)
    showSuccess()
   })
 }

 initCookieSettings()
 document.addEventListener("astro:page-load", initCookieSettings)
</script>

<style>
 .cookie-settings {
  width: 100%;
 }

 .panel {
  max-width: 800px;
  margin: 0 auto;
  background: #fff6eb;
  border: 2px solid #203048;
  border-radius: 12px;
  padding: 2rem;
  color: #203048;
 }

 .header {
  text-align: center;
  margin-bottom: 1.75rem;
  padding-bottom: 1.25rem;
  border-bottom: 1px solid rgba(32, 48, 72, 0.15);
 }

 .header h2 {
  margin: 0 0 0.75rem;
  font-size: 1.75rem;
 }

 .header p {
  margin: 0;
  line-height: 1.5;
  opacity: 0.9;
 }

 .success {
  background: color-mix(in srgb, #e06731 18%, white);
  border: 1px solid #e06731;
  color: #203048;
  font-weight: 700;
  text-align: center;
  padding: 0.9rem 1rem;
  border-radius: 8px;
  margin-bottom: 1.25rem;
 }

 .success[hidden] {
  display: none !important;
 }

 .categories {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  margin-bottom: 1.75rem;
 }

 .category {
  background: color-mix(in srgb, #e06731 12%, white);
  border: 1px solid rgba(32, 48, 72, 0.12);
  border-radius: 10px;
  padding: 1.15rem 1.25rem;
 }

 .category-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1rem;
  margin-bottom: 0.65rem;
 }

 .category-label {
  display: flex;
  align-items: center;
  gap: 0.7rem;
  font-weight: 700;
  cursor: pointer;
 }

 .category-label input {
  width: 18px;
  height: 18px;
  accent-color: #e06731;
 }

 .status {
  font-size: 0.85rem;
  font-weight: 700;
  padding: 0.25rem 0.7rem;
  border-radius: 999px;
  background: rgba(32, 48, 72, 0.08);
  white-space: nowrap;
 }

 .category-desc {
  margin: 0;
  line-height: 1.5;
  opacity: 0.9;
 }

 .actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
  justify-content: flex-end;
  margin-bottom: 1.25rem;
 }

 .btn {
  min-height: 44px;
  padding: 0.75rem 1.35rem;
  border-radius: 999px;
  border: 2px solid #203048;
  font-weight: 700;
  cursor: pointer;
 }

 .btn-reset {
  background: transparent;
  color: #203048;
 }

 .btn-save {
  background: #203048;
  color: #fff6eb;
 }

 .btn-save:hover {
  background: #e06731;
  border-color: #e06731;
 }

 .legal {
  margin: 0;
  text-align: center;
  font-size: 0.95rem;
 }

 .legal a {
  color: #e06731;
  font-weight: 700;
 }

 @media (max-width: 768px) {
  .panel {
   padding: 1.25rem;
  }

  .category-header {
   flex-direction: column;
   align-items: flex-start;
  }

  .actions {
   flex-direction: column;
  }

  .btn {
   width: 100%;
  }
 }
</style>
