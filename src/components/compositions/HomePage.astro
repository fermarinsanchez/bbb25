  padding: 28px 24px 32px;
  border: 3px solid #fff6eb;
  border-radius: 4px;
  background: #0a0a0a;
  color: #fff6eb;
  text-align: center;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.45);
 }

 .children-modal::backdrop {
  background: rgba(32, 48, 72, 0.72);
  backdrop-filter: blur(2px);
 }

 .children-modal[open] {
  animation: modalIn 0.28s ease-out;
 }

 .children-modal-close {
  position: absolute;
  top: 8px;
  right: 12px;
  border: none;
  background: transparent;
  color: #fff6eb;
  font-size: 1.75rem;
  line-height: 1;
  cursor: pointer;
  opacity: 0.75;
 }

 .children-modal-close:hover {
  opacity: 1;
 }

