const djs = ["Head and Banger", "Alfonso Monasterio"]
const ticketsUrl = "https://toledoentradas.es/balambamboo-fest-2026/"
const eventIso = "2026-10-31T12:00:00+01:00"
const msPerDay = 1000 * 60 * 60 * 24
const daysLeftSSR = Math.ceil(
