---
import cartelAplazado from "../../assets/cartel-bbf-aplazado.png"
---

<div class='landing'>
 <div class='atmosphere' aria-hidden='true'></div>

 <section class='hero' aria-label='Balambam Boo Fest aplazado'>
  <div class='hero-copy'>
   <p class='hero-brand'>Balambam Boo Fest</p>
   <h1 class='hero-title'>Aplazado</h1>
   <p class='hero-lead'>
    Anunciaremos la nueva fecha en cuanto la tengamos cerrada.
   </p>
   <a href='#comunicado' class='cta cta-secondary'>Leer comunicado</a>
  </div>
  <div class='stage'>
   <img
    src={cartelAplazado.src}
    alt='Cartel Balambam Boo Fest con banner de aplazado'
    class='hero-poster'
    width={cartelAplazado.width}
    height={cartelAplazado.height}
    fetchpriority='high'
   />

   <section class='comunicado reveal' id='comunicado' data-reveal>
    <div class='comunicado-banner' aria-hidden='true'>
     <span>Comunicado</span>
    </div>
    <div class='comunicado-inner'>
     <h2 class='comunicado-heading'>Balambam Boo Fest aplazado</h2>

     <div class='comunicado-body'>
      <p>
       Ante el accidente ferroviario ocurrido ayer en la provincia de Toledo, y
       con todo nuestro respeto a las víctimas, a sus familias y allegados,
       hemos decidido aplazar el <strong>Balambam Boo Fest</strong> que iba a
       celebrarse el sábado 31 de octubre en la Terraza Summerland.
      </p>
      <p>
       Anunciaremos la nueva fecha en cuanto la tengamos cerrada. Las entradas
       anticipadas seguirán siendo válidas para la nueva fecha. Quien prefiera
       la devolución podrá solicitarla en la plataforma en cuanto confirmemos el
       día.
      </p>
      <p>
       Gracias a las bandas y a todas las personas colaboradoras que nos
       acompañáis, por vuestra comprensión.
      </p>
      <p>
       Todo nuestro cariño y nuestro apoyo para las personas afectadas. También
       queremos agradecer su labor a todas las personas que están ayudando en
       estos momentos tan difíciles.
      </p>
     </div>
    </div>
   </section>
  </div>
 </section>
</div>

<script>
 const reduceMotion = window.matchMedia(
  "(prefers-reduced-motion: reduce)",
 ).matches

 function initScrollReveal() {
  const items = document.querySelectorAll<HTMLElement>("[data-reveal]")
  if (!items.length) return

  if (reduceMotion) {
   items.forEach((el) => el.classList.add("is-revealed"))
   return
  }

  const observer = new IntersectionObserver(
   (entries) => {
    entries.forEach((entry) => {
     if (!entry.isIntersecting) return
     entry.target.classList.add("is-revealed")
     observer.unobserve(entry.target)
    })
   },
   {
    threshold: 0.18,
    rootMargin: "0px 0px -8% 0px",
   },
  )

  items.forEach((el) => observer.observe(el))
 }

 initScrollReveal()
 document.addEventListener("astro:page-load", initScrollReveal)
</script>

<style>
 .landing {
  --bbf-orange: #e06731;
  --bbf-orange-soft: color-mix(in srgb, #e06731 50%, white);
  --bbf-orange-deep: #c45322;
  --bbf-navy: #203048;
  --bbf-cream: #fff6eb;
  --bbf-stage: 920px;

  position: relative;
  background:
   radial-gradient(
    ellipse 90% 55% at 50% -10%,
    color-mix(in srgb, var(--bbf-cream) 55%, transparent) 0%,
    transparent 55%
   ),
   linear-gradient(
    180deg,
    color-mix(in srgb, var(--bbf-orange) 28%, white) 0%,
    var(--bbf-orange-soft) 42%,
    color-mix(in srgb, var(--bbf-orange-deep) 35%, var(--bbf-orange-soft)) 100%
   );
  color: var(--bbf-navy);
  min-height: 100vh;
  overflow-x: clip;
 }

 .atmosphere {
  position: absolute;
  inset: 0;
  pointer-events: none;
  background-image:
   radial-gradient(
    circle at 12% 22%,
    color-mix(in srgb, var(--bbf-navy) 10%, transparent) 0 1.5px,
    transparent 2px
   ),
   radial-gradient(
    circle at 78% 18%,
    color-mix(in srgb, var(--bbf-navy) 9%, transparent) 0 1.5px,
    transparent 2px
   ),
   radial-gradient(
    circle at 88% 64%,
    color-mix(in srgb, var(--bbf-navy) 8%, transparent) 0 1.5px,
    transparent 2px
   );
  background-size: 140px 140px, 180px 180px, 160px 160px;
  opacity: 0.45;
  mask-image: linear-gradient(180deg, black 0%, transparent 85%);
 }

 .hero {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
 }

 .hero-copy {
  width: 100%;
  max-width: var(--bbf-stage);
  margin: 0 auto;
  box-sizing: border-box;
  padding: clamp(28px, 6svh, 56px) 16px clamp(20px, 4svh, 36px);
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32px;
  animation: fadeUp 0.85s ease-out both;
 }

 .hero-brand {
  margin: 0;
  font-family: var(--font-spooky);
  font-size: clamp(1.7rem, 7vw, 3rem);
  line-height: 1;
  letter-spacing: 0.02em;
  text-transform: uppercase;
  color: var(--bbf-cream);
  text-shadow:
   3px 3px 0 var(--bbf-navy),
   -1px 0 0 var(--bbf-navy),
   0 -1px 0 var(--bbf-navy);
  animation: brandIn 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.05s both;
 }

 .hero-title {
  margin: 0;
  font-family: var(--font-spooky);
  font-size: clamp(2.8rem, 13vw, 5.6rem);
  line-height: 0.9;
  letter-spacing: 0.03em;
  text-transform: uppercase;
  color: var(--bbf-navy);
  text-shadow: 4px 4px 0 color-mix(in srgb, var(--bbf-cream) 70%, white);
  animation: titleIn 1s cubic-bezier(0.22, 1, 0.36, 1) 0.15s both;
 }

 .hero-lead {
  margin: 0 auto;
  max-width: 28rem;
  font-size: clamp(0.98rem, 2.4vw, 1.15rem);
  line-height: 1.45;
  font-weight: 600;
  color: var(--bbf-navy);
 }

 .stage {
  width: 100%;
  max-width: var(--bbf-stage);
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 0;
 }

 .hero-poster {
  width: 100%;
  height: auto;
  display: block;
  margin: 0;
  animation: posterIn 1.05s cubic-bezier(0.22, 1, 0.36, 1) 0.28s both;
 }

 .comunicado {
  position: relative;
  z-index: 1;
  width: 100%;
  margin: 0 0 clamp(48px, 9vw, 88px);
  background:
   linear-gradient(
    135deg,
    color-mix(in srgb, var(--bbf-cream) 92%, white) 0%,
    color-mix(in srgb, var(--bbf-cream) 78%, var(--bbf-orange)) 100%
   );
  color: var(--bbf-navy);
  border-block: 6px solid var(--bbf-navy);
  box-shadow:
   inset 0 0 0 1px color-mix(in srgb, var(--bbf-orange) 35%, transparent),
   0 18px 0 color-mix(in srgb, var(--bbf-navy) 18%, transparent);
  overflow: hidden;
 }

 .comunicado::before {
  content: "";
  position: absolute;
  inset: auto -8% 18% -8%;
  height: 54px;
  background: var(--bbf-navy);
  transform: rotate(-7deg);
  opacity: 0.08;
  pointer-events: none;
 }

 .comunicado-banner {
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 56px;
  padding: 12px 20px;
  background: var(--bbf-navy);
  color: var(--bbf-cream);
  transform: rotate(-2.5deg) scale(1.04);
  transform-origin: center;
  margin: 18px -2% 8px;
  box-shadow: 0 6px 0 color-mix(in srgb, var(--bbf-orange-deep) 70%, black);
 }

 .comunicado-banner span {
  font-family: var(--font-spooky);
  font-size: clamp(1.45rem, 5vw, 2.2rem);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  line-height: 1;
 }

 .comunicado-inner {
  position: relative;
  z-index: 1;
  padding: clamp(20px, 4vw, 36px) clamp(18px, 4vw, 40px)
   clamp(28px, 5vw, 44px);
  display: flex;
  flex-direction: column;
  gap: 18px;
 }

 .comunicado-heading {
  margin: 0;
  font-family: var(--font-spooky);
  font-size: clamp(1.55rem, 4.8vw, 2.35rem);
  line-height: 1.05;
  letter-spacing: 0.03em;
  text-transform: uppercase;
  color: var(--bbf-navy);
  text-shadow: 2px 2px 0 color-mix(in srgb, var(--bbf-orange) 35%, white);
 }

 .comunicado-body {
  display: flex;
  flex-direction: column;
  gap: 16px;
 }

 .comunicado-body p {
  margin: 0;
  font-size: clamp(1rem, 2.1vw, 1.12rem);
  line-height: 1.55;
  font-weight: 500;
  color: var(--bbf-navy);
 }

 .comunicado-body strong {
  font-weight: 800;
  color: var(--bbf-orange-deep);
 }

 .cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  padding: 10px 18px;
  border-radius: 999px;
  font-weight: 800;
  font-size: 0.95rem;
  letter-spacing: 0.02em;
  text-decoration: none;
  transition:
   transform 0.2s ease,
   background-color 0.2s ease,
   color 0.2s ease,
   border-color 0.2s ease;
 }

 .cta:hover {
  transform: translateY(-1px);
 }

 .cta-secondary {
  background: color-mix(in srgb, var(--bbf-cream) 80%, white);
  color: var(--bbf-navy);
  border: 2px solid var(--bbf-navy);
 }

 .cta-secondary:hover {
  background: var(--bbf-cream);
 }

 .reveal {
  opacity: 0;
  transform: translate3d(0, 28px, 0);
  transition:
   opacity 0.75s cubic-bezier(0.22, 1, 0.36, 1),
   transform 0.75s cubic-bezier(0.22, 1, 0.36, 1);
 }

 .reveal.is-revealed {
  opacity: 1;
  transform: translate3d(0, 0, 0);
 }

 @keyframes fadeUp {
  from {
   opacity: 0;
   transform: translateY(18px);
  }
  to {
   opacity: 1;
   transform: translateY(0);
  }
 }

 @keyframes brandIn {
  from {
   opacity: 0;
   transform: translateY(12px) scale(0.98);
  }
  to {
   opacity: 1;
   transform: translateY(0) scale(1);
  }
 }

 @keyframes titleIn {
  from {
   opacity: 0;
   transform: translateY(16px) scale(0.94);
  }
  to {
   opacity: 1;
   transform: translateY(0) scale(1);
  }
 }

 @keyframes posterIn {
  from {
   opacity: 0;
   transform: translateY(24px);
  }
  to {
   opacity: 1;
   transform: translateY(0);
  }
 }

 @media (min-width: 900px) {
  .hero-copy {
   padding-inline: 24px;
  }
 }

 @media (prefers-reduced-motion: reduce) {
  .hero-copy,
  .hero-brand,
  .hero-title,
  .hero-poster,
  .reveal {
   animation: none !important;
   opacity: 1;
   transform: none;
   transition: none;
  }
 }
</style>
