    <span
     class='bat'
     data-egg-bat
     data-speed={bat.speed}
     data-rotate={bat.rotate}
     style={`top:${bat.top};${bat.left ? `left:${bat.left};` : ""}${bat.right ? `right:${bat.right};` : ""}width:${bat.size}px;--bat-rotate:${bat.rotate}deg;--bat-delay:${(index % 7) * 0.35}s;--bat-duration:${3.2 + (index % 5) * 0.45}s;`}
     data-bat={index}
    >
     <img
      src={bat.src}
      alt=''
      class='bat-img'
      width={bat.size}
      height={Math.round(bat.size * 0.54)}
      loading='lazy'
     />
    </span>
   ))
