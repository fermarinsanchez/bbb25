  text-transform: inherit;
  cursor: pointer;
  transform: rotate(0deg) scale(1);
  box-shadow: none;
  outline: 1px dashed transparent;
  outline-offset: -7px;
  transition:
   color 0.2s ease,
   background-color 0.2s ease,
   border-color 0.2s ease,
   box-shadow 0.2s ease,
   transform 0.22s cubic-bezier(0.22, 1, 0.36, 1),
