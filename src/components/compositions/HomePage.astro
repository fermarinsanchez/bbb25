  Proyecto one-shot de Halloween · covers de The Misfits · solo el 31 de
  octubre. Nacen, tocan y desaparecen. Como debe ser.
 </p>
</dialog>

<script>
 const trigger = document.querySelector("[data-special-trigger]")
 const modal = document.getElementById(
  "children-modal",
 ) as HTMLDialogElement | null
 const closeBtn = document.querySelector("[data-modal-close]")

 function openModal() {
  if (!modal) return
  modal.showModal()
 }

 function closeModal() {
  if (!modal) return
  modal.close()
 }

 trigger?.addEventListener("click", openModal)
 closeBtn?.addEventListener("click", closeModal)

 modal?.addEventListener("click", (event) => {
  if (event.target === modal) closeModal()
 })

 const bats = document.querySelectorAll<HTMLElement>(".bat")
 const reduceMotion = window.matchMedia(
  "(prefers-reduced-motion: reduce)",
 ).matches
 let ticking = false

 function initEasterEggs() {
  const witch = document.querySelector<HTMLElement>(".hero-witch")
  const toast = document.querySelector<HTMLElement>("[data-egg-toast]")
  const eggBats = Array.from(
   document.querySelectorAll<HTMLElement>("[data-egg-bat]"),
  )
  let batHits = 0
  let batEggDone = false

  const landing = document.querySelector(".landing")

  function spawnBatHitCue(bat: HTMLElement, count: number) {
   const rect = bat.getBoundingClientRect()
   const cue = document.createElement("span")
   cue.className = "bat-hit-cue"
   cue.textContent = `${count}/5`
   cue.style.left = `${rect.left + rect.width / 2}px`
   cue.style.top = `${rect.top + rect.height / 2}px`
   ;(landing ?? document.body).appendChild(cue)
   requestAnimationFrame(() => cue.classList.add("is-on"))
   window.setTimeout(() => {
    cue.classList.remove("is-on")
    cue.classList.add("is-out")
    window.setTimeout(() => cue.remove(), 320)
   }, 700)
  }

  function registerBatHit(bat: HTMLElement) {
   if (batEggDone) return

   bat.classList.remove("is-bonked")
   void bat.offsetWidth
   bat.classList.add("is-bonked")
   window.setTimeout(() => bat.classList.remove("is-bonked"), 450)

   batHits += 1
   spawnBatHitCue(bat, batHits)

   if (batHits < 5) return

   batEggDone = true
   witch?.classList.add("is-egg-spin")
   window.setTimeout(
    () => witch?.classList.remove("is-egg-spin"),
    reduceMotion ? 0 : 1600,
   )

   if (!toast) return
   toast.hidden = false
   requestAnimationFrame(() => toast.classList.add("is-visible"))
   window.setTimeout(() => {
    toast.classList.remove("is-visible")
    window.setTimeout(() => {
     toast.hidden = true
    }, 350)
   }, 3200)
  }

  function findBatNearPoint(x: number, y: number) {
   const pad = 32
   let hit: HTMLElement | null = null
   let best = Infinity

   for (const bat of eggBats) {
    const rect = bat.getBoundingClientRect()
    if (rect.width < 4 || rect.height < 4) continue
    if (rect.bottom < 0 || rect.top > window.innerHeight) continue
    if (rect.right < 0 || rect.left > window.innerWidth) continue
    // Murciélagos cruzando invisibles: no cuentan
    const opacity = Number(getComputedStyle(bat).opacity)
    if (opacity < 0.15) continue

    const cx = rect.left + rect.width / 2
    const cy = rect.top + rect.height / 2
    const dist = Math.hypot(x - cx, y - cy)
    const radius = Math.max(rect.width, rect.height) / 2 + pad
    if (dist <= radius && dist < best) {
     best = dist
     hit = bat
    }
   }

   return hit
  }

  eggBats.forEach((bat) => {
   bat.setAttribute("title", "¿Pip?")
   bat.addEventListener("click", (event) => {
    event.preventDefault()
    event.stopPropagation()
    registerBatHit(bat)
   })
  })

  // En mobile el contenido tapa a los bats (z-index); detectamos toque cercano
  document.addEventListener(
   "click",
   (event) => {
    if (batEggDone) return
    const target = event.target as Element | null
    if (!target) return
    if (target.closest("[data-egg-bat]")) return
    if (
     target.closest(
      "a, button, [role='button'], input, textarea, select, label, .cta, dialog, .egg-toast, .children-modal-close",
     )
    ) {
     return
    }

    const hit = findBatNearPoint(event.clientX, event.clientY)
    if (hit) registerBatHit(hit)
   },
   true,
  )

  const konami = [
   "ArrowUp",
   "ArrowUp",
   "ArrowDown",
   "ArrowDown",
   "ArrowLeft",
   "ArrowRight",
   "ArrowLeft",
   "ArrowRight",
   "b",
   "a",
  ]
  let konamiIndex = 0

  window.addEventListener("keydown", (event) => {
   const key =
    event.key.length === 1 ? event.key.toLowerCase() : event.key
   if (key === konami[konamiIndex]) {
    konamiIndex += 1
    if (konamiIndex === konami.length) {
     konamiIndex = 0
     openModal()
    }
    return
   }
   konamiIndex = key === konami[0] ? 1 : 0
  })
 }

 initEasterEggs()

 function initBootSplash() {
  const splash = document.querySelector<HTMLElement>("[data-boot-splash]")
  if (!splash || splash.dataset.played === "1") return

  if (reduceMotion) {
   document.documentElement.style.setProperty("--boot-splash-ms", "0ms")
   splash.remove()
   return
  }

  splash.dataset.played = "1"
  document.documentElement.classList.add("boot-splash-active")

  const splashMs = 2000
  document.documentElement.style.setProperty(
   "--boot-splash-ms",
   `${splashMs}ms`,
  )

  window.setTimeout(() => {
   splash.classList.add("is-done")
   document.documentElement.classList.remove("boot-splash-active")
   const cleanup = () => splash.remove()
   splash.addEventListener("transitionend", cleanup, { once: true })
   // Por si transitionend no dispara
   window.setTimeout(cleanup, 500)
  }, splashMs)
 }

 initBootSplash()
 document.addEventListener("astro:page-load", initBootSplash)

 function updateScrollNight() {
  const max = Math.max(
   document.documentElement.scrollHeight - window.innerHeight,
   1,
  )
  const raw = window.scrollY / max
  // Empieza ~25% del scroll y llega a noche plena al final
  const t = Math.min(1, Math.max(0, (raw - 0.25) / 0.75))
  const eased = t * t * (3 - 2 * t)
  document.documentElement.style.setProperty(
   "--scroll-night",
   eased.toFixed(4),
  )
 }

 function updateParallax() {
  if (reduceMotion) return
  const y = window.scrollY
  bats.forEach((bat) => {
   const speed = Number(bat.dataset.speed || 0.2)
   // Capas más separadas: vertical fuerte + ligero drift horizontal
   const depth = 0.08 + speed * 1.55
   bat.style.transform = `translate3d(${y * speed * 0.12}px, ${y * depth}px, 0)`
  })
  ticking = false
 }

 function onScroll() {
  updateScrollNight()
  if (reduceMotion || ticking) return
  ticking = true
  requestAnimationFrame(updateParallax)
 }

 window.addEventListener("scroll", onScroll, { passive: true })
 updateScrollNight()
 updateParallax()

 function initCountdown() {
  const els = document.querySelectorAll<HTMLElement>("[data-countdown]")
  if (!els.length) return
  const source = [...els].find((el) => el.dataset.event)
  const eventIsoAttr = source?.dataset.event
  if (!eventIsoAttr) return

  const eventMs = new Date(eventIsoAttr).getTime()
  const dayMs = 1000 * 60 * 60 * 24
  const hourMs = 1000 * 60 * 60

  function label() {
   const diff = eventMs - Date.now()
   if (diff <= 0 && diff > -dayMs) return "¡Es hoy!"
   if (diff <= -dayMs) return "¡Gracias por venir!"
   const days = Math.floor(diff / dayMs)
   const hours = Math.floor((diff % dayMs) / hourMs)
   if (days > 1) return `Faltan ${days} días y ${hours} h`
   if (days === 1) return `Falta 1 día y ${hours} h`
   if (hours > 1) return `Faltan ${hours} horas`
   return "Falta menos de una hora"
  }

  function tick() {
   const text = label()
   els.forEach((el) => {
    el.textContent = text
   })
  }

  tick()
  window.setInterval(tick, 60 * 1000)
 }

 initCountdown()

 function initScrollReveal() {
  const items = document.querySelectorAll<HTMLElement>("[data-reveal]")
  if (!items.length) return

  if (reduceMotion) {
   items.forEach((el) => el.classList.add("is-revealed"))
   return
  }

  const observer = new IntersectionObserver(
   (entries) => {
    entries.forEach((entry) => {
     if (!entry.isIntersecting) return
     entry.target.classList.add("is-revealed")
     observer.unobserve(entry.target)
    })
   },
   {
    threshold: 0.18,
    rootMargin: "0px 0px -8% 0px",
   },
  )

  items.forEach((el) => observer.observe(el))
 }

 initScrollReveal()
 document.addEventListener("astro:page-load", initScrollReveal)

 document.documentElement.classList.remove("has-bat-cursor")
</script>

