---
import Footer from "../components/Footer/Footer.astro"
import CookieBanner from "../components/CookieConsent/CookieBanner.astro"
import "../styles/main.css"
import { ClientRouter } from "astro:transitions"
import { buildSiteUrl } from "../config/site.js"

export interface Props {
 title?: string
 bandImage?: string
 description?: string
 image?: string
}

const {
 title = "Balambam Boo Fest 2026",
 bandImage,
 description = "Edición Halloween. Sábado 31 de octubre de 2026 en Terraza Summerland (Toledo). Rock, brujas y vinilos para todas las edades.",
 image = "/cartel-bbf26.png",
} = Astro.props
---

<!doctype html>
<html lang='es'>
 <head>
  <meta charset='UTF-8' />
  <meta name='viewport' content='width=device-width' />
  <link rel='icon' type='image/svg+xml' href={buildSiteUrl("/favicon.svg")} />
  <meta name='generator' content={Astro.generator} />
  {bandImage && <link rel='preload' as='image' href={bandImage} />}

  <title>{title}</title>
  <meta name='description' content={description} />
  <meta name='author' content='Balambam Boo Fest' />

  <meta property='og:type' content='website' />
  <meta property='og:url' content={Astro.url.href} />
  <meta property='og:title' content={title} />
  <meta property='og:description' content={description} />
  <meta
   property='og:image'
   content={new URL(buildSiteUrl(image), Astro.url).href}
  />
  <meta property='og:image:width' content='1200' />
  <meta property='og:image:height' content='630' />
  <meta property='og:site_name' content='BBooFest 2026' />
  <meta property='og:locale' content='es_ES' />

  <meta name='twitter:card' content='summary_large_image' />
  <meta name='twitter:url' content={Astro.url.href} />
  <meta name='twitter:title' content={title} />
  <meta name='twitter:description' content={description} />
  <meta
   name='twitter:image'
   content={new URL(buildSiteUrl(image), Astro.url).href}
  />
  <meta name='twitter:site' content='@balambamboofest' />

  <meta name='theme-color' content='#EFB398' />
  <meta name='msapplication-TileColor' content='#EFB398' />
  <link rel='canonical' href={Astro.url.href} />

  <script>
   ;(function (w, d, s, l, i) {
    w[l] = w[l] || []
    w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" })
    var f = d.getElementsByTagName(s)[0],
     j = d.createElement(s),
     dl = l != "dataLayer" ? "&l=" + l : ""
    j.async = true
    j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl
    f.parentNode.insertBefore(j, f)
   })(window, document, "script", "dataLayer", "GTM-529278XZ")
  </script>

  <script async src='https://www.googletagmanager.com/gtag/js?id=G-Z05HNTX8Q6'
  ></script>
  <script>
   window.dataLayer = window.dataLayer || []
   function gtag() {
    dataLayer.push(arguments)
   }
   gtag("js", new Date())
   gtag("config", "G-Z05HNTX8Q6")
  </script>
 </head>
 <body>
  <noscript
   ><iframe
    src='https://www.googletagmanager.com/ns.html?id=GTM-529278XZ'
    height='0'
    width='0'
    style='display:none;visibility:hidden'></iframe></noscript
  >

  <main class='main-content'>
   <slot />
  </main>

  <Footer />

  <CookieBanner />
  <ClientRouter />
 </body>
</html>

<style>
 html,
 body {
  margin: 0;
  width: 100%;
  min-height: 100vh;
  background-color: #efb398;
 }

 .main-content {
  min-height: 100vh;
 }
</style>
