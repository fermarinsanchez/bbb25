---
import Layout from "../layouts/Layout.astro"
import CookieSettingsPage from "../components/CookieConsent/CookieSettingsPage.astro"
import { Typography } from "../components/Typography"
import { getMetaConfig } from "../config/meta.js"

const meta = getMetaConfig("cookies")
---

<Layout title={meta.title} description={meta.description} image={meta.image}>
 <div class='cookies-page'>
  <div class='page-header'>
   <Typography variant='headline-1'>Configuración de Cookies</Typography>
   <Typography variant='body'>
    Gestiona tus preferencias de cookies para personalizar tu experiencia en
    Balambam Boo Fest 2026.
   </Typography>
  </div>

  <CookieSettingsPage />
 </div>
</Layout>

<style>
 .cookies-page {
  padding: clamp(3rem, 8vw, 5rem) 1rem 4rem;
  background: transparent;
  min-height: 70vh;
 }

 .page-header {
  text-align: center;
  margin-bottom: 2.5rem;
  max-width: 800px;
  margin-left: auto;
  margin-right: auto;
 }

 .page-header :global(.typography--headline-1) {
  color: #203048;
  margin-bottom: 0.75rem;
 }

 .page-header :global(.typography--body) {
  color: #203048;
  font-size: 1.1rem;
  line-height: 1.6;
 }

 @media (max-width: 768px) {
  .cookies-page {
   padding: 2rem 0.75rem 3rem;
  }
 }
</style>
